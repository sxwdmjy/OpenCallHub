# ============================================================
# openCallHub 生产环境变量模板
# 复制为 .env.production 并修改实际值
# ============================================================

# ─── 数据库 ───
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=openCallHub
MYSQL_USER=och_user
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── RabbitMQ ───
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# ─── 应用服务 ───
OCH_API_PORT=4320
OCH_FILE_PORT=9527
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC

# ─── FreeSWITCH ───
FS_HOST=freeswitch
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
FS_PROFILE=/record

# ─── Nginx ───
NGINX_PORT=80
NGINX_SSL_PORT=443
DOMAIN=opencallhub.local

# ─── 监控端口 ───
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# ─── JWT ───
JWT_SECRET=change_me_jwt_secret_key_min_32_chars

# ─── 日志级别 ───
LOG_LEVEL=info
